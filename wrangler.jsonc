{
  "name": "random-mcp",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // öffentliche Adresse https://random-mcp.<konto>.workers.dev einschalten
  "workers_dev": true,
  // Protokoll: eigene console.log-Einträge + automatische Aufruf-Logs im Dashboard speichern
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
